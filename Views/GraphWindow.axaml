<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpeedMeterApp.ViewModels"
        x:DataType="vm:GraphViewModel"
        x:Class="SpeedMeterApp.Views.GraphWindow"
        Title="Network Graph" Height="300" Width="500"
        SystemDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        PointerPressed="Window_PointerPressed">
    
    <Border Background="#121212" CornerRadius="10" BorderBrush="#333333" BorderThickness="1">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Real-time Network Traffic" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="10" Height="10" Fill="#4CAF50" Margin="0,0,5,0"/>
                    <TextBlock Text="Upload" Foreground="#CCCCCC" Margin="0,0,15,0"/>
                    
                    <Ellipse Width="10" Height="10" Fill="#2196F3" Margin="0,0,5,0"/>
                    <TextBlock Text="Download" Foreground="#CCCCCC" Margin="0,0,15,0"/>
                    
                    <Button Content="✕" Foreground="#888888" Background="Transparent" BorderThickness="0" 
                            FontSize="16" FontWeight="Bold" Cursor="Hand" Click="CloseButton_Click" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
            
            <!-- Graph Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Y-Axis Scale -->
                <Grid Grid.Column="0" Margin="0,0,10,0" Width="65">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="{Binding MaxSpeedText}" Foreground="#888888" FontSize="11" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Row="0" Text="{Binding MaxSpeed75Text}" Foreground="#888888" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-7"/>
                    <TextBlock Grid.Row="1" Text="{Binding MaxSpeed50Text}" Foreground="#888888" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-7"/>
                    <TextBlock Grid.Row="2" Text="{Binding MaxSpeed25Text}" Foreground="#888888" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-7"/>
                    <TextBlock Grid.Row="3" Text="0 KB/s" Foreground="#888888" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                </Grid>
                
                <!-- Drawing Canvas -->
                <Border Grid.Column="1" BorderBrush="#333333" BorderThickness="0,0,0,1" Background="#1A1A1A">
                    <Canvas x:Name="GraphCanvas" SizeChanged="GraphCanvas_SizeChanged" ClipToBounds="True">
                        <!-- Horizontal Grid Lines -->
                        <Line x:Name="GridLine75" Stroke="#2A2A2A" StrokeDashArray="2,2" StartPoint="0,0" EndPoint="1000,0"/>
                        <Line x:Name="GridLine50" Stroke="#2A2A2A" StrokeDashArray="2,2" StartPoint="0,0" EndPoint="1000,0"/>
                        <Line x:Name="GridLine25" Stroke="#2A2A2A" StrokeDashArray="2,2" StartPoint="0,0" EndPoint="1000,0"/>
                        
                        <!-- Data Lines -->
                        <Polyline x:Name="UploadLine" Stroke="#4CAF50" StrokeThickness="2" StrokeJoin="Round"/>
                        <Polyline x:Name="DownloadLine" Stroke="#2196F3" StrokeThickness="2" StrokeJoin="Round"/>
                        
                        <!-- Current Value Projection Lines -->
                        <Line x:Name="CurrentUploadLine" Stroke="#4CAF50" StrokeDashArray="4,4" Opacity="0.5" StartPoint="0,0" EndPoint="0,0"/>
                        <Line x:Name="CurrentDownloadLine" Stroke="#2196F3" StrokeDashArray="4,4" Opacity="0.5" StartPoint="0,0" EndPoint="0,0"/>
                        
                        <!-- Current Value Labels -->
                        <TextBlock x:Name="CurrentUploadText" Foreground="#4CAF50" FontSize="10" Background="#1A1A1A" Padding="2,0"/>
                        <TextBlock x:Name="CurrentDownloadText" Foreground="#2196F3" FontSize="10" Background="#1A1A1A" Padding="2,0"/>
                    </Canvas>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
