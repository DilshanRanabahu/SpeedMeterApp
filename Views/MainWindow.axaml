<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpeedMeterApp.ViewModels"
        x:DataType="vm:MainViewModel"
        x:Class="SpeedMeterApp.Views.MainWindow"
        Title="SpeedMeterApp" Height="65" Width="145"
        SystemDecorations="None" ShowInTaskbar="False" CanResize="False"
        Background="Transparent" TransparencyLevelHint="Transparent" Topmost="True"
        Loaded="Window_Loaded"
        PointerPressed="Window_PointerPressed">

    <Border Background="#B3000000" CornerRadius="8" Padding="10,5">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Show Graph" Click="ShowGraph_Click">
                    <MenuItem.Icon>
                        <Canvas Width="16" Height="16">
                            <!-- Axes -->
                            <Path Data="M2,2 V14 H14" Stroke="#777777" StrokeThickness="1.5" StrokeLineCap="Round"/>
                            <!-- Chart Line -->
                            <Path Data="M3,10 L7,5 L10,7 L14,2" Stroke="#4CAF50" StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round"/>
                        </Canvas>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click" Foreground="#FF5252">
                    <MenuItem.Icon>
                        <Canvas Width="16" Height="16">
                            <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="#FF5252" StrokeThickness="1.5" StrokeLineCap="Round"/>
                        </Canvas>
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Border.ContextMenu>
        
        <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="▲" Foreground="#4CAF50" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding UploadSpeed}" Foreground="White" FontSize="14" FontWeight="Bold" Width="40" TextAlignment="Right"/>
                <TextBlock Text="{Binding UploadUnit}" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,1" Width="35"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="▼" Foreground="#2196F3" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DownloadSpeed}" Foreground="White" FontSize="14" FontWeight="Bold" Width="40" TextAlignment="Right"/>
                <TextBlock Text="{Binding DownloadUnit}" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,1" Width="35"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
